# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site (ignore docs/ in subdirs; keep root docs/ for repo-level documentation)
docs/
!/docs/
!/docs/**
!09_analysis/docs/
!09_analysis/docs/**
!01_ids/docs
!02_terraclimate/docs
!05_fia/docs/
05_fia/docs/*
!05_fia/docs/dashboard/
!05_fia/docs/fiadb_dashboard.py
!05_fia/docs/fia_data_dashboard.py
!05_fia/docs/build_fiadb_user_guide_index.py
!05_fia/docs/fiadb_user_guide_index_v94.json
!06_species_niches/docs/
!06_species_niches/docs/**
!07_thermophilization/docs/
!07_thermophilization/docs/**
# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Data folders: keep the directory skeleton via .gitkeep, but ignore bulk data.
**/data/**
!**/data/**/
!**/data/**/.gitkeep

# Dashboard static aggregates: small JSON/CSV that drive the deployed
# dashboard's interactive charts (no parquets, ~2 MB total).
!docs/dashboard/static/data/
!docs/dashboard/static/data/**

# FIA raw CSVs too large for GitHub (TREE tables are 100MB-840MB per state)
05_fia/data/raw/**/*_TREE.csv
05_fia/data/raw/**/*_TREE_GRM_COMPONENT.csv

# FIA processed outputs are generated data: regenerated locally or on the
# server by a pipeline rerun, never committed. Keep only directory skeletons.
05_fia/data/processed/**
!05_fia/data/processed/**/
!05_fia/data/processed/**/.gitkeep
!05_fia/data/processed/site_climate/
!05_fia/data/processed/site_climate/all_site_locations.csv
# site_climate.parquet and site_pixel_map.parquet are intentionally NOT un-ignored:
# the national extraction is 5.85 GB, well over GitHub's 100 MB hard limit.

# Root processed outputs are legacy/local-only. Active modules keep their own
# data directories and documented output locations.
processed/

# Scratch / session working files (agent scratchpads, ad-hoc analysis). Never commit.
scratch_output/

# Generated QA artifacts are local build products, regardless of file size.
# Keep producers, tests, and optional directory placeholders; do not commit
# run-specific tables, figures, maps, or reports.
**/qa/outputs/**
!**/qa/outputs/
!**/qa/outputs/.gitkeep
**/qa/figures/**
!**/qa/figures/
!**/qa/figures/.gitkeep

# Archived or local-only material. Keep locally if useful, but do not publish
# in the polished repo.
archive/**
output/**
logs/**
tree.txt
data_tree.txt
site_climate_extract.log

# Generated repository inventories and data dictionaries. Their producer code
# is the source of truth; regenerate these locally when needed.
/docs/FIA_DATA_DICTIONARY.md
/docs/fia_data_dictionary.json
/docs/MASTER_PRODUCT_INVENTORY.md
/forest_explorer/catalog/generated/**

# Species niche smoke-test outputs: useful local history, not commit material.
06_species_niches/qa/smoke/**
!06_species_niches/qa/smoke/
!06_species_niches/qa/smoke/.gitkeep
06_species_niches/data/smoke/**
!06_species_niches/data/smoke/
!06_species_niches/data/smoke/.gitkeep

# Thermophilization smoke-test outputs: useful local history, not commit material.
07_thermophilization/qa/smoke/**
!07_thermophilization/qa/smoke/
!07_thermophilization/qa/smoke/.gitkeep
07_thermophilization/data/smoke/**
!07_thermophilization/data/smoke/
!07_thermophilization/data/smoke/.gitkeep

# Thermophilization QA outputs are regenerated locally by validation and
# product-builder scripts. Transfer them with data products when needed, but do
# not commit run-specific CSVs.
07_thermophilization/qa/outputs/**
!07_thermophilization/qa/outputs/
!07_thermophilization/qa/outputs/.gitkeep

# Disturbance-linkage QA and local working notes are regenerated or personal.
08_disturbance_linkage/qa/outputs/**
!08_disturbance_linkage/qa/outputs/
!08_disturbance_linkage/qa/outputs/.gitkeep
08_disturbance_linkage/qa/smoke/**
!08_disturbance_linkage/qa/smoke/
!08_disturbance_linkage/qa/smoke/.gitkeep
/08_disturbance_linkage/DISTURBANCE_ANALYSIS_READINESS.md
/docs/METHOD_DECISIONS_NEEDED.md
/docs/THERMOPHILIZATION_DISTURBANCE_AUDIT_*.md

# Standalone point-climate extraction outputs. Keep the input CSV and scripts
# tracked, but leave generated climate products local.
site_climate/qa/outputs/**
!site_climate/qa/outputs/
!site_climate/qa/outputs/.gitkeep

# FIA QA outputs are regenerated locally by validation scripts.
05_fia/qa/outputs/**
!05_fia/qa/outputs/
!05_fia/qa/outputs/.gitkeep

# Large binary file types (safety net for files outside data/ dirs)
*.nc
*.gpkg
*.db
*.sqlite
*.gdb.zip

# User specific
local/
.devcontainer/
.vscode/
meeting.md
__pycache__/
*.pyc

# Re-ignore Python bytecode under docs/ (overrides the !/docs/** un-ignore above)
/docs/**/__pycache__/
/docs/**/*.pyc

# Misplaced gcloud SDK install (typed "yes" instead of accepting default install path)
yes/

# Claude settings
.claude/

email-re-FIA.pdf
